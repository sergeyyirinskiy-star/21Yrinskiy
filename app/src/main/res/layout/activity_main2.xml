<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#333333">

    <!-- Верхняя дорожка -->
    <View
        android:id="@+id/topRoad"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="#555555"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Нижняя дорожка -->
    <View
        android:id="@+id/bottomRoad"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="#555555"
        app:layout_constraintTop_toBottomOf="@id/topRoad"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Разделительная линия между дорожками -->
    <View
        android:id="@+id/roadLine"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topRoad"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Линия старта -->
    <View
        android:id="@+id/startLine"
        android:layout_width="6dp"
        android:layout_height="300dp"
        android:background="#00FF00"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="0dp" />

    <!-- Линия финиша -->
    <View
        android:id="@+id/finishLine"
        android:layout_width="12dp"
        android:layout_height="300dp"
        android:background="#FF0000"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Машина первого игрока -->
    <ImageView
        android:id="@+id/playerCar"
        android:layout_width="80dp"
        android:layout_height="120dp"
        android:src="@drawable/carp"
        android:contentDescription="Машина первого игрока"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp" />

    <!-- Машина второго игрока -->
    <ImageView
        android:id="@+id/enemyCar"
        android:layout_width="80dp"
        android:layout_height="120dp"
        android:src="@drawable/care"
        android:contentDescription="Машина второго игрока"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roadLine"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp" />

    <!-- Кнопка игрока 1 -->
    <Button
        android:id="@+id/leftButton"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:text="ИГРОК 1"
        android:textSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="30dp"
        android:layout_marginBottom="20dp" />

    <!-- Кнопка старта -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:text="СТАРТ"
        android:textSize="18sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp" />

    <!-- Кнопка игрока 2 -->
    <Button
        android:id="@+id/rightButton"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:text="ИГРОК 2"
        android:textSize="16sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>